{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/src/img/bumper.gif",
      "destination": "/img/bumper.gif"
    }
  ],
  "redirects": [
    {
      "source": "/art",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/art/",
      "destination": "/portfolio",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(img|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff|woff2|png|jpg|jpeg|gif|webp|avif|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://stats.sirkorgo.com"
        }
      ]
    },
    {
      "source": "/.well-known/matrix/client",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/matrix/server",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/atproto-did",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Content-Type", "value": "text/plain" }
      ]
    }
  ]
}
