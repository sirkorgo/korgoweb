{
  "name": "korgoweb",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "cms": "decap-server",
    "build:css": "sass --load-path=node_modules src/css/global.scss public/css/global.css",
    "build": "npm run build:css && astro build",
    "watch:css": "sass --load-path=node_modules --watch src/css/global.scss:public/css/global.css src/css/post.scss:public/css/post.css",
    "dev:cms": "concurrently \"npm run watch:css\" \"astro dev\" \"decap-server\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/cabin-condensed": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.2",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^7.2.0",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "decap-server": "^3.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.102.0"
  }
}
