---
import Layout from '../layouts/default.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const comics = await getCollection('comics');

type SeriesGroup = {
  name: string;
  items: typeof comics;
};

const seriesMap = new Map<string, typeof comics>();
for (const comic of comics) {
  const s = comic.data.series;
  if (!seriesMap.has(s)) seriesMap.set(s, []);
  seriesMap.get(s)!.push(comic);
}

const seriesGroups: SeriesGroup[] = Array.from(seriesMap.entries()).map(([name, items]) => ({
  name,
  items: items.sort((a, b) => a.data.chapter - b.data.chapter),
}));

const art = await getCollection('art');
art.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Sitemap" colors="default">
  <div class="content">
    <h1>Sitemap</h1>
    <h2>Pages</h2>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/comics">Webcomics</a></li>
      <li><a href="/portfolio">Portfolio</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/blog/archive">Blog Archive</a></li>
      <li><a href="/guestbook">Guestbook</a></li>
      <li><a href="/is-this-site-ai">AI Usage Statement</a></li>
    </ul>

    <h2>Blog Posts</h2>
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>{post.data.title}</a> — {formatDate(post.data.date)}
        </li>
      ))}
    </ul>

    <h2>Comics</h2>
    {seriesGroups.map((group) => (
      <div>
        <h3>{group.name}</h3>
        <ul>
          {group.items.map((comic) => (
            <li>
              <a href={`/comics/${comic.id}`}>{comic.data.title}</a> — {formatDate(comic.data.date)}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <h2>Artworks</h2>
    <ul>
      {art.map((piece) => (
        <li>
          <a href={`/art/${piece.id}`}>{piece.data.title}</a> — {formatDate(piece.data.date)}
        </li>
      ))}
    </ul>
  </div>
</Layout>
