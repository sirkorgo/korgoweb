---
import Layout from "../../layouts/default.astro";
import { getCollection } from "astro:content";
import { excerptTool } from "../../js/excerpt.js";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

type MonthGroup = {
  label: string;
  items: typeof posts;
};

const groups: MonthGroup[] = [];
let currentGroup: MonthGroup | null = null;

for (const post of posts) {
  const label = post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
  if (!currentGroup || currentGroup.label !== label) {
    currentGroup = { label, items: [] };
    groups.push(currentGroup);
  }
  currentGroup.items.push(post);
}

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}

function getFirstImage(body?: string) {
  if (!body) return null;
  const match = body.match(/<img[^>]+src=["']([^"']+)["']/i);
  if (!match) return null;
  let src = match[1];
  if (src.startsWith("/src/img/")) src = src.replace("/src/img/", "/img/");
  if (src.startsWith("/src/assets/")) src = src.replace("/src/assets/", "/assets/");
  return src;
}
---

<Layout title="Blog Archive" colors="blog">
  <div class="container pulse">
    <div class="content">
      <span class="heading">
        <h1 style="margin: 0; min-width: fit-content;">Blog Archives</h1><a
          href="/blog"
          style="width: 100%; display: flex; justify-content: flex-end;">
          <button class="generic-btn">← Go Back</button>
        </a>
      </span>
      <div class="shelf">
        {
          groups.map((month) => (
            <div>
              <h3 style="margin-bottom: 10px; margin-top: 0; padding-bottom: 5px; border-bottom: solid 1px grey;">
                {month.label}
              </h3>
              <div class="archiveShelf">
                {month.items.map((post) => {
                  const excerpt = `${excerptTool(post.body).substring(0, 140)}...`;
                  const thumb = getFirstImage(post.body);
                  return (
                    <div>
                      <a class="" href={`/blog/${post.id}`}>
                        <div style="display: flex; flex-direction: row-reverse; align-items: center; gap: 10px;">
                          <span>
                            <p style="margin-bottom: 0px;">{formatDate(post.data.date)}</p>
                            {post.data.title}
                            <br style="margin-top: 5px;" />
                            <p>{excerpt}</p>
                          </span>
                          {thumb && (
                            <img
                              src={thumb}
                              alt={post.data.title}
                              loading="lazy"
                              decoding="async"
                              style="width: 100px; height: 100px; object-fit: cover"
                            />
                          )}
                        </div>
                      </a>
                    </div>
                  );
                })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
