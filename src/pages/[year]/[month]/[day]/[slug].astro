---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const paths = [];

  for (const entry of posts) {
    const d = new Date(entry.data.date);
    const year = String(d.getUTCFullYear());
    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');

    const match = entry.id.match(/^\d{4}-\d{1,2}-\d{1,2}-(.*)$/);
    const slug = match ? match[1] : entry.id;

    paths.push({
      params: { year, month, day, slug },
      props: { targetUrl: `/blog/${entry.id}` },
    });
  }

  return paths;
}

const { targetUrl } = Astro.props;
return Astro.redirect(targetUrl, 301);
---
