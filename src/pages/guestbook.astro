---
import Layout from '../layouts/default.astro';
---

<Layout title="Guestbook" colors="guestbook" desc="Sign the guestbook!">
  <div class="container pulse">
    <div class="content">
      <span class="heading"><h1 style="text-align: left; margin: 0;">Guestbook</h1></span>
      <div id="guestbook-wrapper"></div>
    </div>
  </div>

  <script>
    async function getSocialService(service: string) {
      if (service === 'guestbook') {
        const wrapper = document.getElementById('guestbook-wrapper');
        if (!wrapper) return;
        try {
          const res = await fetch('/api/social/moderator');
          
          if (!res.ok) throw new Error(`Moderator check returned status ${res.status}`);
          
          const { blocked } = await res.json();
          if (blocked) {
            wrapper.innerHTML = `
              <span style="display: flex; gap: 10px; justify-content: center; align-items: center; padding: 20px 0;">
                <img src="/img/banners/wget-dead.webp" width="200px" height="200px">
                <span style="max-width: 50%;">
                  <h2>Service Unavailable</h2>
                  <p><b>You can't sign the guestbook right now.</b> Unfortunately, someone on your current network was misusing the guestbook and/or comment section, resulting in a permanent IP ban.<br>To appeal this ban, please contact sirkorgo from the About page.<br>
                  <small style="color: gray;"><i>Reference Code: ACCESS_RESTRICTED</i></small>
                  </p>
                </span>
              </span>
            `;
          } else {
            wrapper.innerHTML = `
              <iframe
                src="https://sirkorgo.atabook.org"
                width="100%"
                height="700px"
                style="border: none; border-radius: 15px"
              ></iframe>
            `;
          }
        } catch (e) {
          console.log('socialServices error:', e);
          wrapper.innerHTML = `
            <span style="display: flex; gap: 10px; justify-content: center; align-items: center; padding: 20px 0;">
              <img src="/img/emblems/srkgo-dizzy.webp" width="200px" height="200px">
              <span style="max-width: 50%;">
                <h2>Something went wrong.</h2>
                <p><b>You can't sign the guestbook right now.</b>Your device couldn't be verified. This may be because the moderation service is experiencing disruptions.<br>If this error persists, please contact Sirkorgo from the About page.<br>
                <small style="color: gray;"><i>Reference Code: MODERATION_FAIL</i></small>
                </p>
              </span>
            </span>
          `;
        }
      }
    }

    document.addEventListener('DOMContentLoaded', () => getSocialService('guestbook'));
  </script>
</Layout>
