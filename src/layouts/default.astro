---
// src/layouts/default.astro
import "../css/global.scss";
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import Preload from "../components/preload.astro";

interface Props {
  title?: string;
  desc?: string;
  colors?: string;
  url?: string;
}

const {
  title = "sirkorgo.com",
  desc = "Home of Sirkorgo, a shapeshifting corgi, and his friends. Read comics about the world he lives in, Cloudspace, and read blog posts from the creator.",
  colors = "default",
  url = Astro.url.pathname,
} = Astro.props;

const pageTitle = title === "Index" ? "sirkorgo.com" : `${title} (sirkorgo.com)`;
const footerTitle = title;
---

<!doctype html>
<html id="html" class={`${colors} light `} lang="en-US">
  <head>
    <meta charset="utf-8" />
    <Preload />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline={true} defer src="https://u.widget.st/ar.js"></script>
    <title>{pageTitle}</title>

    <meta property="og:title" content="sirkorgo.com" />
    <meta name="description" content={desc} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={`https://www.sirkorgo.com${url}`} />
    <meta property="og:image" content="https://www.sirkorgo.com/img/emblems/thegang.webp" />
  </head>

  <body>
    <img
      fetchpriority="high"
      class="field"
      alt="A distant field on sirkorgo.com"
      src="/img/bg-field.webp"
    />
    <div class="bg-layer"></div>
    <main>
      <Navbar />
      <slot />
      <Footer title={footerTitle} />
    </main>
  </body><script is:inline src="https://cursor-party.sirkorgo.partykit.dev/cursors.js"></script>
</html>
