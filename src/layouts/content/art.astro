---
// src/layouts/content/art.astro
import "../../css/global.scss";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";
import Comments from "../../components/comments.astro";
import Preload from "../../components/preload.astro";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  date?: Date | string;
  image?: string;
  excerpt?: string;
}

const { title = "Art", date, image = "", excerpt = "" } = Astro.props;

const pageTitle = `${title} (sirkorgo.com)`;
const footerTitle = title;
const formattedDate = date
  ? new Date(date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : "";

// Retrieve all entries from the 'art' collection
const allArt = await getCollection("art");

// Sort chronologically using schema-validated Date objects
allArt.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Match current item by id/slug
const currentSlug = Astro.params.slug;
const currentIndex = allArt.findIndex(
  (item) => item.id === currentSlug || (item as any).slug === currentSlug,
);

// Calculate Prev/Next wrapping indices
const prevIndex = currentIndex - 1 < 0 ? allArt.length - 1 : currentIndex - 1;
const nextIndex = (currentIndex + 1) % allArt.length;

const prev = allArt[prevIndex];
const next = allArt[nextIndex];
---

<!doctype html>
<html id="html" class="default light canvas" lang="en">
  <head>
    <Preload />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={excerpt} />
    <meta property="og:title" content={`An artwork by sirkorgo: ${title}`} />
    <meta property="og:description" content={excerpt} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={image} />

    <style>
      .artPage {
        text-align: right;
        display: flex;
        width: 100%;
        justify-content: center;
      }

      :global(nav) {
        background: none !important;
        margin-top: 10px;
      }

      @media (max-width: 1200px) {
        .artPage {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
      }
    </style>
  </head>

  <body>
    <Navbar hideBanner={true} />
    <span style="display: flex; justify-content: center;">
      <a href="https://ko-fi.com/sirkorgo">
        <img width="185" height="37" alt="Support me on Ko-Fi" src="/img/kofi.webp" />
      </a>
    </span>

    <div class="page" style="min-height: fit-content;">
      <section class="pageHeader">
        <a href="/portfolio"><button class="generic-btn">← Go Back</button></a>
        <p><b>{title}</b></p>
        <span style="display: flex; gap: 0;">
          <a href={next ? `/art/${next.id}` : "#"} style="margin-left: 5px;">
            <button
              style="border-radius: 4px 0px 0px 4px !important; border-right: none;"
              class="generic-btn">
              ←
            </button>
          </a>
          <a href={prev ? `/art/${prev.id}` : "#"}>
            <button
              style="border-radius: 0px 4px 4px 0px !important; border-left: none;"
              class="generic-btn">
              →
            </button>
          </a>
        </span>
      </section>
      <hr />
      <section class="artPage" style="gap: 15px;">
        <div id="art-content">
          <img src={image} alt={title} />
        </div>
        <span class="sidebar">
          <span>
            <h2>{title}</h2>
            {formattedDate && <p>Created on {formattedDate}</p>}
            <br />
            <slot />
          </span>
        </span>
      </section>
    </div>

    <Comments />

    <script is:inline src="https://cursor-party.sirkorgo.partykit.dev/cursors.js"></script>

    <Footer title={footerTitle} />
  </body>
</html>
