---
import "../../css/global.scss";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";
import Comments from "../../components/comments.astro";
import Preload from "../../components/preload.astro";

interface Props {
  title?: string;
  date?: Date | string;
  author?: string;
  excerpt?: string;
}

const { title = "sirkorgo.com", date, author = "sirkorgo", excerpt = "" } = Astro.props;

const pageTitle = `${title} (sirkorgo.com)`;
const footerTitle = title;
const formattedDate = date
  ? new Date(date).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : "";
---

<!doctype html>
<html id="html" class="default light blog" lang="en">
  <head>
    <Preload />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={excerpt} />
    <meta property="og:title" content={`A post about ${title} on sirkorgo.com`} />
    <meta property="og:description" content={excerpt} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://www.sirkorgo.com/img/emblems/thegang.webp" />
    <style>
      :global(nav) {
        background: none !important;
        margin-top: 10px;
      }
    </style>
  </head>

  <body>
    <Navbar hideBanner={true} />
    <span style="display: flex; justify-content: center;">
      <a href="https://ko-fi.com/sirkorgo">
        <img width="185" height="37" alt="Support me on Ko-Fi" src="/img/kofi.webp" />
      </a>
    </span>
    <div class="page">
      <section class="pageHeader">
        <a href="/blog"><button class="generic-btn">← Go Back</button></a>
        <p>
          <b>{formattedDate} • {title}</b>
        </p>
      </section>
      <hr />
      <section>
        <h2>{title}</h2>
        <p>
          Posted on {formattedDate}, by {author}
        </p>
        <br />
        <slot />
      </section>
    </div>
    <Comments />
    <script is:inline src="https://cursor-party.sirkorgo.partykit.dev/cursors.js"></script>
    <Footer title={footerTitle} />
  </body>
</html>
