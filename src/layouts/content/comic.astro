---
import "../../css/global.scss";
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";
import Comments from "../../components/comments.astro";
import { getCollection } from "astro:content";
import Preload from "../../components/preload.astro";

interface Props {
  title?: string;
  series?: string;
  chapter?: number;
  currentId?: string;
}

const { title = "Comic", series = "", chapter = 1, currentId = "" } = Astro.props;

const allComics = await getCollection("comics");
const seriesComics = allComics
  .filter((c) => c.data.series === series)
  .sort((a, b) => a.data.chapter - b.data.chapter);

const pageTitle = `${title} (sirkorgo.com)`;
const footerTitle = title;
---

<!doctype html>
<html id="html" class="default light comics" lang="en">
  <head>
    <Preload />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={`Read ${title}, a comic on sirkorgo.com.`} />
    <meta property="og:title" content={`${title} on sirkorgo.com`} />
    <meta property="og:description" content={`Read ${title}, a comic on sirkorgo.com.`} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://www.sirkorgo.com/img/emblems/thegang.webp" />
    <style>
      :global(nav) {
        background: none !important;
        margin-top: 10px;
      }
    </style>
  </head>

  <body>
    <Navbar hideBanner={true} />
    <span style="display: flex; justify-content: center;">
      <a href="https://ko-fi.com/sirkorgo">
        <img width="185" height="37" alt="Support me on Ko-Fi" src="/img/kofi.webp" />
      </a>
    </span>
    <div class="pageContainer">
      <main class="page">
        <span class="comicHeader">
          <a href="/comics"><button class="generic-btn">← Go Back</button></a>
          <p><b>{series} • Chapter {chapter}</b></p>

          <select onchange="location = this.value" class="dropdown">
            {
              seriesComics.map((comic) => (
                <option value={`/comics/${comic.id}`} selected={comic.id === currentId}>
                  Chapter {comic.data.chapter}
                </option>
              ))
            }
          </select>
        </span>
        <hr />
        <br />
        <span class="comicContent">
          <slot />
        </span>
      </main>
    </div>
    <Comments />

    <script is:inline src="https://cursor-party.sirkorgo.partykit.dev/cursors.js"></script>
    <Footer title={footerTitle} />
  </body>
</html>
