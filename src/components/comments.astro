<div class="page" style="min-height: fit-content; margin-top: 0;">
  <span>
    <p><b>Comments</b></p>
    <hr />
  </span>

  <span style="display: flex; flex-direction: column; gap: 5px;">
    <form id="f" class="write">
      <input
        id="u"
        class="write textbox"
        style="max-width: 25%;"
        placeholder="Name"
        maxlength="50"
        required
      />
      <div
        style="display: grid; grid-template-columns: 1fr auto; gap: 10px; width: 100%; align-items: end; margin-top: 5px;">
        <div>
          <textarea
            id="m"
            placeholder="Message"
            rows="1"
            class="write textbox"
            maxlength="250"
            required
            style="resize: none; overflow-y: hidden; width: 100%; display: block;">
          </textarea>
          <div id="count" style="font-size: 11px; color: gray; margin: 4px 0 0 2px;">
            250 characters remaining
          </div>
        </div>
        <button class="generic-btn" style="min-height: 38px; border-radius: 10px; padding: 0 20px;">
          Post
        </button>
      </div>
    </form>

    <div id="box"></div>
  </span>
</div>

<script is:inline>
  import "../js/comments.js";
</script>
