---
interface Props {
  title?: string;
}

const { title = "an Unknown Page" } = Astro.props;
---

<footer>
  <span style="display: flex; justify-content: center;">
    <a href="https://ko-fi.com/sirkorgo">
      <img width="185" height="37" alt="Support me on Ko-Fi" src="/img/kofi.webp" />
    </a>
  </span>
  <span
    style="
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    ">
    <a href="/is-this-site-ai">
      <img
        alt="Written by a human, not by AI."
        width="130px"
        height="42px"
        src="/img/buttons/notbyai.svg"
      />
    </a>
    <p style="text-align: left;">
      ©Sirkorgo 2026. Made with whimsy and <a href="https://astro.build">Astro</a> by sirkorgo.
      <br />
      <small>
        <a href="/is-this-site-ai">AI Usage Statement •</a>
        <a href="/sitemap">
          Currently visiting {title} • View Sitemap
        </a>
      </small>
    </p>
  </span>
</footer>
