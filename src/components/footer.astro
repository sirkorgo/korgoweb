---
interface Props {
  title?: string;
}

const { title = "an Unknown Page" } = Astro.props;
---

<footer
  style="
    padding-top: 45px;
    padding-bottom: 20px;
    text-align: center;
    align-items: center;
    gap: 15px;
    display: flex;
    flex-direction: column;
    justify-content: start;
  ">
  <script type="text/javascript" src="https://storage.ko-fi.com/cdn/widget/Widget_2.js"></script>
  <script type="text/javascript">
    kofiwidget2.init("Support me on Ko-fi", "#3076f0", "T6T61WP8KV");
    kofiwidget2.draw();
  </script>
  <span
    style="
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    ">
    <a href="/is-this-site-ai">
      <img width="130px" src="/img/notbyai.svg" />
    </a>
    <p style="text-align: left; color: white">
      ©Sirkorgo 2026. Made with love and<a href="https://astro.build">Astro</a>by sirkorgo.
      <br />
      <small>
        <a href="/is-this-site-ai">AI Usage Statement •</a>
        <a href="/sitemap">
          Currently visiting {title} • View Sitemap
        </a>
      </small>
    </p>
  </span>
</footer>
