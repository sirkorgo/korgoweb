---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/public/{assets,img}/**/*.{png,jpg,jpeg,webp,gif,svg}",
);

async function createThumb(rawPath?: string, width = 300): Promise<string | undefined> {
  if (!rawPath) return undefined;

  try {
    let cleanPath = rawPath.trim().replace(/^(\.\.\/)+/, "/");

    if (cleanPath.startsWith("/src/img/")) {
      cleanPath = cleanPath.replace("/src/img/", "/public/img/");
    } else if (cleanPath.startsWith("/src/assets/")) {
      cleanPath = cleanPath.replace("/src/assets/", "/public/assets/");
    } else if (cleanPath.startsWith("/assets/")) {
      cleanPath = `/public${cleanPath}`;
    } else if (cleanPath.startsWith("/img/")) {
      cleanPath = `/public${cleanPath}`;
    } else if (!cleanPath.startsWith("/public/")) {
      cleanPath = `/public/assets/${cleanPath.replace(/^\//, "")}`;
    }

    const imageImporter = imageModules[cleanPath];

    if (!imageImporter) return undefined;

    const imageModule = await imageImporter();
    const optimized = await getImage({
      src: imageModule.default,
      width: 270,
      format: "webp",
      quality: 50,
    });

    return optimized.src;
  } catch (e) {
    console.error(`Failed to generate thumbnail for: ${rawPath}`, e);
    return undefined;
  }
}

const comics = await getCollection("comics");
const posts = await getCollection("posts");
const changelogs = await getCollection("changelogs");
const art = await getCollection("art");

type FeedEntry = {
  type: "Comic" | "Art" | "Update" | "Post";
  date: Date;
  title: string;
  url: string;
  thumb?: string;
  ContentComponent?: any;
};

const formattedComics: FeedEntry[] = await Promise.all(
  comics.map(async (entry) => {
    let rawThumb = "";
    if (entry.data?.series === "Cloudspace") {
      rawThumb = "/img/banners/cloudspace-thumb.gif";
    } else if (entry.data?.series === "Sirkorgo! In the Meantime...") {
      rawThumb = "/img/banners/meantime-thumb.gif";
    }

    return {
      type: "Comic",
      date: entry.data.date,
      title: entry.data.title,
      url: `/comics/${entry.id}`,
      thumb: await createThumb(rawThumb, 300),
    };
  }),
);

const formattedArt: FeedEntry[] = await Promise.all(
  art.map(async (entry) => ({
    type: "Art",
    date: entry.data.date,
    title: entry.data.title,
    url: `/art/${entry.id}`,
    thumb: await createThumb(entry.data?.image, 300),
  })),
);

const formattedPosts: FeedEntry[] = await Promise.all(
  posts.map(async (entry) => {
    const body = entry.body || "";
    const match = body.match(/<img[^>]+src=["']([^"']+)["']/i) || body.match(/!\[.*?\]\((.*?)\)/);
    const firstImageSrc = match ? match[1] : undefined;

    return {
      type: "Post",
      date: entry.data.date,
      title: entry.data.title,
      url: `/blog/${entry.id}`,
      thumb: await createThumb(firstImageSrc, 300),
    };
  }),
);

const formattedChangelogs: FeedEntry[] = await Promise.all(
  changelogs.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      type: "Update",
      date: entry.data.date,
      title: entry.data.title,
      url: "#",
      ContentComponent: Content,
    };
  }),
);

const allEntries = [...formattedComics, ...formattedArt, ...formattedPosts, ...formattedChangelogs]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 10);

const col1 = allEntries.filter((_, idx) => idx % 2 === 0);
const col2 = allEntries.filter((_, idx) => idx % 2 === 1);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
function formatDateAttr(date: Date) {
  return date.toISOString().split("T")[0];
}
---

<div class="changec">
  <h3 style="margin: 0; padding: 0;">What's New?</h3>
  <section class="changelog">
    <div class="changelog-track" id="changelog-track">
      <div class="changelog-col">
        {
          col1.map((entry) =>
            entry.type === "Update" ? (
              <div
                class="changelog-item changelog-item--Update"
                data-date={formatDateAttr(entry.date)}>
                <p style="margin: 0; font-size: 16px;">Update</p>
                <span class="changelog-date">
                  <p style="margin: 0;">
                    <b>{formatDate(entry.date)}</b>
                  </p>
                </span>
                <span class="changelog-title">
                  <p>{entry.title}</p>
                </span>
                <div class="changelog-content">
                  {entry.ContentComponent && <entry.ContentComponent />}
                </div>
              </div>
            ) : (
              <a
                class={`changelog-item changelog-item--${entry.type}`}
                href={entry.url}
                data-date={formatDateAttr(entry.date)}>
                <p style="margin: 0; font-size: 16px;">{entry.type}</p>
                <span class="changelog-date">
                  <b>{formatDate(entry.date)}</b>
                </span>
                <span class="changelog-title">
                  <p>{entry.title}</p>
                </span>
                {entry.thumb && (
                  <img
                    class="changelog-thumb"
                    src={entry.thumb}
                    alt={entry.title}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </a>
            ),
          )
        }
      </div>
      <div class="changelog-col">
        {
          col2.map((entry) =>
            entry.type === "Update" ? (
              <div
                class="changelog-item changelog-item--Update"
                data-date={formatDateAttr(entry.date)}>
                <p style="margin: 0; font-size: 16px;">Update</p>
                <span class="changelog-date">
                  <p style="margin: 0;">
                    <b>{formatDate(entry.date)}</b>
                  </p>
                </span>
                <span class="changelog-title">
                  <p>{entry.title}</p>
                </span>
                <div class="changelog-content">
                  {entry.ContentComponent && <entry.ContentComponent />}
                </div>
              </div>
            ) : (
              <a
                class={`changelog-item changelog-item--${entry.type}`}
                href={entry.url}
                data-date={formatDateAttr(entry.date)}>
                <p style="margin: 0; font-size: 16px;">{entry.type}</p>
                <span class="changelog-date">
                  <b>{formatDate(entry.date)}</b>
                </span>
                <span class="changelog-title">
                  <p>{entry.title}</p>
                </span>
                {entry.thumb && (
                  <img
                    class="changelog-thumb"
                    src={entry.thumb}
                    alt={entry.title}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </a>
            ),
          )
        }
      </div>
    </div>
  </section>
</div>

<style>
  .changelog {
    width: 100%;
  }
  .changelog-track {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 0;
    align-items: flex-start;
  }
  .changelog-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    min-width: 0;
  }
  .changelog-item {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--font);
    width: 100%;
    padding: 10px;
    transition: opacity 0.15s;
    background: var(--content-bg);
    border-radius: 15px;
    overflow: hidden;
  }
  .changelog-thumb {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
  }
  .changelog-content {
    font-size: 0.8rem;
    margin-top: 4px;
  }
</style>
